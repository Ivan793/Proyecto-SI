# =========================================
# PROYECTO FASTAPI + FIREBASE (.gitignore)
# =========================================

# --- Entornos virtuales ---
venv/
env/
.venv/

# --- Cachés y compilados ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class

# --- Archivos temporales y del sistema ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Archivos de construcción y distribución ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- IDEs y editores ---
.vscode/
.idea/

# --- Variables de entorno ---
.env
.env.local
.env.*.local

# --- Archivos de log ---
*.log
logs/

# --- Bases de datos locales ---
*.db
*.sqlite
*.sqlite3

# --- Archivos de pruebas ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Archivos temporales ---
tmp/
temp/
*.tmp

# =========================================
# Credenciales y llaves privadas (Firebase)
# =========================================
firebase_credentials.json
serviceAccountKey.json
*-firebase-adminsdk-*.json
*.firebase.json
*.key.json
*.credentials.json

# --- Otros archivos sensibles ---
*.pem
*.crt
*.csr
*.key
